<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_cream">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka Rekening"
                android:textColor="#1C1C1C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:rotation="-12"
                android:background="@drawable/bg_badge_mustard"
                android:padding="7dp"
                android:src="@drawable/ic_star" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lengkapi data buat nasabah baru"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Card Data Nasabah -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_shadow_block"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_mustard"
                android:padding="18dp">

                <EditText
                    android:id="@+id/etNasabahName"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Nama Lengkap"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etNasabahKtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="NIK / No. KTP"
                    android:inputType="number"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etNasabahPhone"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="No. HP Aktif"
                    android:inputType="phone"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:id="@+id/etNasabahAddress"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Alamat Domisili"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Card Pilih Produk -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_shadow_block"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sky"
                android:padding="18dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProducts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
            </LinearLayout>
        </FrameLayout>

        <Button
            android:id="@+id/btnSubmitOpenAccount"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="Lanjut ke Setoran Awal"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:background="@drawable/bg_card_charcoal" />

    </LinearLayout>
    </ScrollView>

</RelativeLayout>
