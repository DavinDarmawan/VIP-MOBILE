<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/bg_screen_cream"
    android:padding="20dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/ic_bolt"
        android:layout_marginBottom="20dp"
        android:alpha="0.5" />

    <TextView
        android:id="@+id/tvPlaceholderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Feature Coming Soon"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1C1C1C" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Halaman ini sedang dalam pengembangan menggunakan sistem Fragment."
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:textColor="#8A8A8A" />

</LinearLayout>
