<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_cream"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tombol Kembali -->
        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_badge_charcoal"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true" />

        <!-- Header dengan sticker rotate -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buka Rekening"
                android:textColor="#1C1C1C"
                android:textSize="26sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:rotation="-12"
                android:background="@drawable/bg_badge_mustard"
                android:padding="7dp"
                android:src="@drawable/ic_star" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lengkapi data buat nasabah baru"
            android:textColor="#8A8A8A"
            android:textSize="13sp"
            android:layout_marginBottom="20dp" />

        <!-- Card Data Nasabah dgn shadow block -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_shadow_block"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_mustard"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_sky"
                        android:padding="6dp"
                        android:src="@drawable/ic_wallet"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DATA NASABAH (CIF)"
                        android:textColor="#1C1C1C"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Nama Lengkap"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="NIK / No. KTP"
                    android:inputType="number"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="No. HP Aktif"
                    android:inputType="phone"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginBottom="10dp" />

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hint="Alamat Domisili"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Card Pilih Produk dgn shadow block -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_shadow_block"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_sky"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_badge_mustard"
                        android:padding="6dp"
                        android:src="@drawable/ic_coin"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PILIH PRODUK TABUNGAN"
                        android:textColor="#1C1C1C"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <Spinner
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Deretan sticker kecil biar rame -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="6dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:rotation="10"
                android:background="@drawable/bg_badge_coral"
                android:padding="5dp"
                android:src="@drawable/ic_heart_small"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:rotation="-10"
                android:background="@drawable/bg_badge_mustard"
                android:padding="5dp"
                android:src="@drawable/ic_bolt"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:rotation="15"
                android:background="@drawable/bg_badge_sky"
                android:padding="5dp"
                android:src="@drawable/ic_star" />
        </LinearLayout>

        <!-- Tombol utama dgn shadow block -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_shadow_block" />

            <Button
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="6dp"
                android:text="Lanjut ke Setoran Awal"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_card_charcoal"
                android:elevation="0dp" />
        </FrameLayout>

    </LinearLayout>
</ScrollView>
